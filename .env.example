# Optional grounded LLM generation. Evidence mode works without these settings.
# Use your provider's /v1 base URL and a model ID available in your account.
TRIAGE_API_KEY=
TRIAGE_BASE_URL=https://api.tokenfactory.nebius.com/v1
TRIAGE_MODEL=
# Optional separate support-check model, using the same Nebius course account.
TRIAGE_VERIFIER_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# Used only when the Nebius embedding backend is explicitly selected.
TRIAGE_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# Week 3 Deep Investigation. Model must support function/tool calling.
FIREWORKS_API_KEY=
# Example model ID: accounts/fireworks/models/gpt-oss-120b
FIREWORKS_MODEL=
KEENABLE_API_KEY=
# Optional: higher public GitHub API limits. Tools only read streamlit/streamlit.
GITHUB_TOKEN=
# Optional tracing; enable deliberately because traces include model/tool content.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=engineering-issue-desk-week3
