            "quote": "\\' in path or any(part in {'.', '..'} for part in path.split('/')))):\n        raise ValueError('GitHub publication evidence is limited to streamlit/streamlit.')\n    if hashlib.sha256(source['text'].encode()).hexdigest() != source.get('sha256'):\n        raise ValueError('The registered public evidence failed its integrity check.')\n    return url\n"
          }
        ]
      }
    ],
